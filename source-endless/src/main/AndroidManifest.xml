<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The daemon is an HTTP service, so this module needs INTERNET even
      though the service is on the LAN — Android draws no distinction.
      Same declaration source-mempalace makes for the same reason.

      NOTE: no cleartext declaration here, deliberately. The daemon speaks
      plain HTTP (the ESP32-C6 watch sharing its API cannot do TLS), and
      Android blocks cleartext by default since 9. The allowlist lives in
      app/src/main/res/xml/network_security_config.xml and is scoped per
      host; it has NOT been widened for this daemon, because the right
      entry is a hostname that doesn't exist yet and allowlisting today's
      bare RFC1918 address would hardcode at build time a value the user
      configures at runtime. See EndlessLitrpgSource's kdoc.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
